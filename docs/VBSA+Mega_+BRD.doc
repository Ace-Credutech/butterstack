<th class=3D"confluenceTh">
<p>Editable</p></th>
<th class=3D"confluenceTh">
<p>Mandatory</p></th>
<th class=3D"confluenceTh">
<p>Notes</p></th>
</tr>
<tr>
<td class=3D"confluenceTd">
<p>First Name</p></td>
<td class=3D"confluenceTd">
<p>=E2=9C=85</p></td>
<td class=3D"confluenceTd">
<p>=E2=9C=85</p></td>
<td class=3D"confluenceTd">
<p>Text</p></td>
</tr>
<tr>

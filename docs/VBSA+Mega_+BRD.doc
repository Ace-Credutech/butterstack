<p>Audit Submission</p></td>
<td class=3D"confluenceTd">
<p>Save audit details and status</p></td>
</tr>
<tr>
<td class=3D"confluenceTd">
<p>Notification Service</p></td>
<td class=3D"confluenceTd">
<p>Email notification to assigned auditor</p></td>
</tr>
<tr>
<td class=3D"confluenceTd">
<p>User Management</p></td>
<td class=3D"confluenceTd">
<p>Identify sub-auditor or third-party details</p></td>
</tr>
</tbody>
</table>
</div>

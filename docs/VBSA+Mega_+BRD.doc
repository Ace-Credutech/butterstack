<p>Column</p></th>
<th class=3D"confluenceTh">
<p>Description</p></th>
</tr>
<tr>
<td class=3D"confluenceTd">
<p>Venue Code</p></td>
<td class=3D"confluenceTd">
<p>Unique code assigned to each venue</p></td>
</tr>
<tr>
<td class=3D"confluenceTd">
<p>District Code</p></td>
<td class=3D"confluenceTd">
<p>Code representing the district where the venue is located</p></td>
</tr>
<tr>
<td class=3D"confluenceTd">
<p>Location</p></td>
<td class=3D"confluenceTd">
<p>City and State of the venue</p></td>
</tr>
<tr>
<td class=3D"confluenceTd">
<p>Venue Name</p></td>

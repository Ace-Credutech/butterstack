PORT=3000
NODE_ENV=development

# Databases
DATABASE_URL_PRIMARY=postgres://localhost:5432/butterstack-2
DATABASE_URL_ANALYTICS=
DATABASE_URL_AUDIT=

# Slow-query logging threshold (ms)
SLOW_QUERY_MS=500

# Redis (BullMQ + sessions + WS pub/sub)
REDIS_URL=redis://localhost:6379

# AI provider routing
AI_PROVIDER=anthropic                    # anthropic | openai | openrouter | minmax | claude-max
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MODEL_DEFAULT=claude-opus-4-7
CONTEXT_BUDGET_TOKENS=12000

# Storage — MinIO (S3-compatible)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
MINIO_REGION=us-east-1
MINIO_USE_SSL=true

# Keycloak OIDC — public client used by FE for user login/register
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_AUDIENCE=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=                             # leave blank for public PKCE client

# Keycloak Admin API — confidential service-account client for user creation
KEYCLOAK_ADMIN_REALM=butterstack                    # realm the backend client lives in
KEYCLOAK_ADMIN_CLIENT_ID=butterstack-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=                       # copy from Keycloak → backend client → Credentials

SESSION_SECRET=change-me
SESSION_COOKIE_NAME=butterstack_sid

# File upload limits (KB) + allowed MIME types (comma-separated)
MAX_IMAGE_SIZE_KB=200
MAX_DOCUMENT_SIZE_KB=2048
MAX_FILE_SIZE_KB=5120
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
